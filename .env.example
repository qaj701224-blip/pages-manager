# Local staging demo deployment token.
# Copy this file to .env and replace the placeholder with your own token.
PAGES_TOKEN=pages_yourname@xd.com

# Optional: target environment used by scripts/test-staging-demos.sh.
# Defaults to staging. Use --target production for production smoke tests.
PAGES_DEMO_TARGET=staging

# Optional: API used by scripts/test-staging-demos.sh.
# Defaults from PAGES_DEMO_TARGET.
# PAGES_API=https://api-staging.workers.xd.team

# Optional: fixed site-name prefix for staging demo deployments.
# Default names are demo-html-img, demo-vue-app, demo-nuxt-app, and demo-api.
PAGES_DEMO_PREFIX=demo

# Optional: keep true to verify the default restricted-site behavior.
PAGES_DEMO_IP_RESTRICT=true

# Optional safety override. Keep false unless intentionally targeting a nonstandard API.
PAGES_DEMO_ALLOW_NON_STAGING=false

# Slack HTTP Events / Interactivity gateway. Keep real tokens in your private local env or secret manager.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# Optional for gateway-based MVP Slack notifications. Defaults to Slack chat.postMessage.
# SLACK_API_URL=https://slack.com/api/chat.postMessage
# SLACK_BOT_USER_ID=U...
# SLACK_AGENT_ANALYZE_URL=http://localhost:8791/internal/slack-agent/analyze
# SLACK_AGENT_SHARED_SECRET=local-slack-agent-secret
# SLACK_EVENTS_PROCESSING_MODE=async
# SLACK_SIGNATURE_REQUIRED=true
# SLACK_REACTION_ON_RECEIVE=true
# SLACK_WORKING_REACTION=eyes
# SLACK_DONE_REACTION=white_check_mark
# SLACK_FAILED_REACTION=x
# SLACK_SIGNATURE_MAX_SKEW_SECONDS=300
# Company model gateway. Keep real tokens in local env or K8s secrets only.
# AGENT_MODEL_PROVIDER=company-agent
# Optional model/router name understood by the company gateway.
# AGENT_MODEL_NAME=
# Company OpenAI-compatible BaseURL. A root URL is normalized to `/v1/chat/completions`;
# values already ending in `/v1` or `/chat/completions` are also supported.
# AGENT_GATEWAY_URL=
# SLACK_AGENT_MAX_CONTEXT_MESSAGES=50
# SLACK_AGENT_MAX_OUTPUT_TOKENS=2048
# SLACK_AGENT_REQUEST_TIMEOUT_SECONDS=120
# SLACK_AGENT_ACTIVE_CONTEXT_TTL_HOURS=2
# SLACK_AGENT_WAITING_CLARIFICATION_TTL_DAYS=1
# SLACK_AGENT_RECENT_SESSION_DAYS=14
# SLACK_AGENT_ARCHIVE_AFTER_DAYS=90
# SLACK_AGENT_TURN_TIMEOUT_SECONDS=120
# SLACK_AGENT_SESSION_LEASE_SECONDS=180
# SLACK_AGENT_PROVIDER_THREAD_TTL_HOURS=24
# CODING_AGENT_RUN_TIMEOUT_MINUTES=30
# SLACK_AGENT_API_KEY=replace-me
# AGENT_CODE_API_KEY=replace-me
# PAGES_EMPLOYEE_SLUG=smoke
# PAGES_SITE_SLUG=profile
# Worker orchestration. In production the GitHub token should come from a GitHub App installation token,
# not a personal Slack user's GitHub account.
# PAGES_WORKER_START_URL=http://localhost:8790/internal/publishing-jobs/start
# PAGES_WORKER_SHARED_SECRET=local-worker-secret
# PAGES_GATEWAY_URL=http://localhost:8788
# Gateway state is MySQL-backed. Configure the MySQL variables used by your local or ECS runtime.
# For actions mode, this must be a public HTTPS tunnel URL, not localhost.
# Example: https://example.trycloudflare.com/internal/executor-callback
# PAGES_GATEWAY_CALLBACK_URL=http://localhost:8788/internal/executor-callback
# Must match GitHub Actions secret PAGES_CALLBACK_TOKEN for local callback smoke tests.
# GitHub Actions variable PAGES_CALLBACK_ALLOWED_ORIGINS must include the callback URL origin.
# Example: https://example.trycloudflare.com
# INTERNAL_CALLBACK_TOKEN=local-callback-secret
# PAGES_GATEWAY_API_TOKEN=local-gateway-api-secret
# GITHUB_ENTERPRISE_API_BASE_URL=https://api.github.com
# GITHUB_REPO=org/pages-manager
# GITHUB_APP_INSTALLATION_TOKEN=ghs_...
# PAGES_WORKFLOW_REF=staging
# Use issue_only for issue intake smoke; use github_issue_webhook for issue -> Coding Agent -> PR.
# PAGES_EXECUTOR_MODE=github_issue_webhook
# PAGES_ISSUE_MODE=smoke_single
# PAGES_SMOKE_ISSUE_SCOPE=local-slack-smoke
# PAGES_PR_MODE=smoke_single
# PAGES_SMOKE_PR_BRANCH=sites/smoke-local-slack-smoke-profile
# Default MVP mode uses pages-preview.yml. local_deploy is only for local smoke.
# PAGES_PREVIEW_MODE=actions
# PAGES_API=https://api-staging.workers.xd.team
# Local smoke only: legacy /deploy owner marker for preview deploy.
# Long-term platform isolation should mint or resolve deploy identity by owner scope / site project / job.
# PAGES_PREVIEW_TOKEN=pages-preview-smoke@xd.com
# Legacy /deploy preview requires IP restriction. Keep true until preview migrates to xd-pages CLI / Pages v2.
# PAGES_PREVIEW_IP_RESTRICT=true
# PAGES_PREVIEW_SITE_NAME_PATTERN=pm-pr-{prNumber}-{employeeSlug}-{siteSlug}
# GITHUB_REVIEW_AGENT_LOGINS=greptile[bot],greptile-bot,copilot-pull-request-reviewer[bot],chatgpt-codex-connector,chatgpt-codex-connector[bot]
# GITHUB_REVIEW_AGENT_TIMEOUT_SECONDS=180
# GITHUB_REVIEW_GATE_RECONCILE_INTERVAL_SECONDS=30

# GitHub Actions preview deploy currently uses repository variable PAGES_API and a staging preview deploy secret
# for compatibility with the legacy /deploy API. This is a platform deploy identity, not an employee token.
# Long-term deploy auth should be gateway/deployer service auth or job/owner-scope-scoped identity.
# PAGES_API should point at the existing pages-manager deploy API.
# Example repository variable: PAGES_API=https://api-staging.workers.xd.team
# Example repository secret: PAGES_PREVIEW_TOKEN=pages-preview-smoke@xd.com

# Local K8s control plane.
# scripts/k8s-local-up.sh builds local images, loads them into a local kind/k3d cluster when possible,
# applies k8s/base/pages-system, and creates K8s secrets from the env vars below.
# Scripts load the repository root .env file. Keep the real .env untracked.
# PAGES_K8S_CLUSTER_NAME=pages-manager
# PAGES_K8S_CLUSTER_TOOL=auto
# PAGES_K8S_IMAGE_TAG=local
# PAGES_K3S_IMAGE=rancher/k3s:v1.31.6-k3s1
# PAGES_K3D_API_PORT=6551
# PAGES_K3D_HTTP_PORT=0
# PAGES_K3D_HTTPS_PORT=0
# PAGES_K3D_APP_PORT=0
# PAGES_K3D_STORAGE_DIR=${HOME}/.local/share/pages-manager/k3d/pages-manager/storage
# PAGES_K8S_BUILD_IMAGES=true
# PAGES_K8S_LOAD_IMAGES=auto
# PAGES_K8S_WAIT=false
# PAGES_K8S_LOG_TARGET=pages-gateway
# PAGES_K8S_LOG_FOLLOW=false
# PAGES_K8S_GATEWAY_LOCAL_PORT=8788
# Check required local K8s variables without printing secret values:
# pnpm k8s:check-env
# Run local control-plane smoke checks after pnpm k8s:up:
# pnpm k8s:smoke
# Run the full local non-destructive validation chain:
# pnpm k8s:validate
# Invasive k3d-only metadata persistence check. This restarts the local k3d control plane:
# pnpm k8s:verify-secret-persistence
# Public HTTPS tunnel URL used by GitHub webhook and GitHub Actions callback.
# PAGES_GATEWAY_PUBLIC_URL=https://example.trycloudflare.com
# Optional shared secret between gateway and apps/slack-agent.
# SLACK_AGENT_SHARED_SECRET=local-slack-agent-secret
# Optional local smoke ports. Override only if these ports are busy.
# PAGES_K8S_SMOKE_GATEWAY_PORT=18788
# PAGES_K8S_SMOKE_WORKER_PORT=18790
# PAGES_K8S_SMOKE_SLACK_AGENT_PORT=18791
