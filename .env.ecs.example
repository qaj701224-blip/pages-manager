# Copy this file to .env.ecs on the ECS host.
# Keep .env.ecs private. Do not commit real tokens, passwords, kubeconfig, or secrets.

### Public HTTPS entrypoint
# External HTTPS terminates before this ECS host. The upstream proxy forwards
# https://tableau.tapdb.com/publisher-test/* to this ECS host port 80.
PUBLIC_HOST=tableau.tapdb.com
PUBLIC_PATH_PREFIX=/publisher-test
PAGES_GATEWAY_PUBLIC_URL=https://tableau.tapdb.com/publisher-test

### Images
# Use the VPC registry from ECS when it is reachable inside Aliyun.
PAGES_IMAGE_REGISTRY=xdclaw-hub-registry-vpc.cn-shanghai.cr.aliyuncs.com/public
# Runtime should point at an immutable deploy tag. `latest` is only an optional
# extra alias for humans and must not be the source of truth for compose.
PAGES_IMAGE_TAG=ecs-YYYYMMDDHHMMSS-sha
CADDY_IMAGE_TAG=2.10-alpine
MYSQL_IMAGE_TAG=8.4
REDIS_IMAGE_TAG=7-alpine

### Local container data plane
MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_USER=pages_manager
MYSQL_PASSWORD=replace-me-pages-manager-password
MYSQL_DATABASE=pages_manager
MYSQL_ADDR=pages-mysql:3306
REDIS_URL=redis://pages-redis:6379/11

### Gateway / runtime state
NODE_ENV=production
PAGES_STORE_BACKEND=mysql
PAGES_DB_AUTO_MIGRATE=true
PAGES_REPO_ROOT=/app

### Internal service URLs
PAGES_GATEWAY_URL=http://pages-gateway:8788
PAGES_WORKER_START_URL=http://pages-worker:8790/internal/publishing-jobs/start
SLACK_AGENT_ANALYZE_URL=http://slack-agent:8791/internal/slack-agent/analyze
SLACK_NOTIFIER_URL=http://slack-notifier:8792

### Internal shared secrets
INTERNAL_CALLBACK_TOKEN=replace-me-callback-secret
PAGES_GATEWAY_API_TOKEN=replace-me-gateway-api-secret
PAGES_WORKER_SHARED_SECRET=replace-me-worker-secret
SLACK_AGENT_SHARED_SECRET=replace-me-slack-agent-secret
SLACK_NOTIFIER_SHARED_SECRET=replace-me-slack-notifier-secret

### Slack
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me-slack-signing-secret
SLACK_SIGNATURE_REQUIRED=true
SLACK_EVENTS_PROCESSING_MODE=async
SLACK_REACTION_ON_RECEIVE=true
SLACK_WORKING_REACTION=eyes
SLACK_API_BASE_URL=https://slack.com/api
MERGE_ANNOUNCEMENT_ENABLED=true
MERGE_ANNOUNCEMENT_CHANNEL_ID=C0BA6713S0L
MERGE_ANNOUNCEMENT_BASE_REFS=master
MERGE_ANNOUNCEMENT_AGENT_ENABLED=true
MERGE_ANNOUNCEMENT_INCLUDE_SITE_PRS=false

### Company OpenAI-compatible model gateway
AGENT_MODEL_PROVIDER=company-agent
AGENT_MODEL_NAME=replace-me-model-name
AGENT_GATEWAY_URL=https://model-gateway.example.com/v1/chat/completions
SLACK_AGENT_API_KEY=replace-me-slack-agent-api-key
AGENT_CODE_API_KEY=replace-me-coding-agent-api-key

### GitHub
GITHUB_REPO=xindong/pages-manager
GITHUB_ENTERPRISE_API_BASE_URL=https://api.github.com
GITHUB_STATUS_TOKEN=
# Long-lived GitHub App credentials. Store the private key as single-line base64:
#   base64 -i xd-cell-bot.private-key.pem | tr -d '\n'
# The runtime exchanges these for short-lived installation tokens.
GITHUB_APP_ID=replace-me-github-app-id
GITHUB_APP_INSTALLATION_ID=replace-me-github-app-installation-id
GITHUB_APP_PRIVATE_KEY_B64=replace-me-base64-encoded-github-app-private-key
# Optional temporary fallback when App credentials are unavailable.
# Leave empty in normal ECS production; installation tokens expire after about 1 hour.
GITHUB_APP_INSTALLATION_TOKEN=
GITHUB_WEBHOOK_SECRET=replace-me-github-webhook-secret
GITHUB_REVIEW_AGENT_LOGINS=greptile[bot],greptile-bot,copilot-pull-request-reviewer[bot],chatgpt-codex-connector,chatgpt-codex-connector[bot]
GITHUB_SITE_CHECK_NAMES=site-check,Site Check / site-check
GITHUB_SITE_CHECK_APP_LOGINS=github-actions,github-actions[bot],GitHub Actions
GITHUB_PLATFORM_CI_CHECK_NAMES=Platform CI,check
GITHUB_PLATFORM_CI_APP_LOGINS=github-actions,github-actions[bot],GitHub Actions

### Publishing workflow
PAGES_WORKFLOW_REF=staging
PAGES_BASE_REF=staging
PAGES_PLATFORM_WORKFLOW_REF=master
PAGES_PLATFORM_BASE_REF=master
PAGES_EXECUTOR_MODE=github_issue_webhook
PAGES_ISSUE_MODE=per_job
PAGES_PR_MODE=per_job
# PAGES_PREVIEW_* controls Site Publishing preview output; it is not an ECS
# runtime environment flag.
PAGES_PREVIEW_MODE=actions
PAGES_API=https://api-staging.workers.xd.team
PAGES_PREVIEW_TOKEN=replace-me-preview-deploy-token
# Legacy /deploy preview rejects ip_restrict=false. Keep this true until preview migrates to xd-pages CLI / Pages v2.
PAGES_PREVIEW_IP_RESTRICT=true
PAGES_PREVIEW_SITE_NAME_PATTERN=pm-pr-{prNumber}-{employeeSlug}-{siteSlug}
PAGES_GATEWAY_CALLBACK_URL=https://tableau.tapdb.com/publisher-test/internal/executor-callback

### Slack session defaults
SLACK_AGENT_ACTIVE_CONTEXT_TTL_HOURS=2
SLACK_AGENT_WAITING_CLARIFICATION_TTL_DAYS=1
SLACK_AGENT_RECENT_SESSION_DAYS=14
SLACK_AGENT_ARCHIVE_AFTER_DAYS=90
SLACK_AGENT_TURN_TIMEOUT_SECONDS=120
SLACK_AGENT_SESSION_LEASE_SECONDS=180
SLACK_AGENT_PROVIDER_THREAD_TTL_HOURS=24
CODING_AGENT_RUN_TIMEOUT_MINUTES=30
