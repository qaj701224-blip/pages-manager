{
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "corepack pnpm --filter @xd/pages-sdk build && node --test \"apps/*/src/**/*.test.js\" \"apps/pages-sdk/test/**/*.test.js\" \"packages/**/*.test.js\" \"scripts/**/*.test.js\" \"tests/**/*.test.js\"",
    "db:generate": "corepack pnpm --filter @xd/gateway drizzle:generate",
    "db:migrate": "corepack pnpm --filter @xd/gateway drizzle:migrate",
    "db:setup": "corepack pnpm --filter @xd/gateway setup-db",
    "db:reset": "corepack pnpm --filter @xd/gateway setup-db:reset",
    "k8s:cluster": "bash scripts/k8s-local-cluster.sh",
    "k8s:check-env": "bash scripts/k8s-local-check-env.sh",
    "k8s:build": "bash scripts/k8s-local-build.sh",
    "k8s:up": "bash scripts/k8s-local-up.sh",
    "k8s:smoke": "bash scripts/k8s-local-smoke.sh",
    "k8s:validate": "bash scripts/k8s-local-validate.sh",
    "k8s:verify-secret-persistence": "bash scripts/verify-k3d-secret-persistence.sh",
    "k8s:status": "bash scripts/k8s-local-status.sh",
    "k8s:logs": "bash scripts/k8s-local-logs.sh",
    "k8s:port-forward": "bash scripts/k8s-local-port-forward.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint --fix . && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0"
  }
}
